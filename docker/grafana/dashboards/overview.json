{
  "dashboard": {
    "title": "PhD Xpert Overview",
    "panels": [
      {
        "title": "API Requests/sec",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])"
          }
        ]
      },
      {
        "title": "Active Users",
        "type": "stat",
        "targets": [
          {
            "expr": "active_users"
          }
        ]
      },
      {
        "title": "Search Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(search_duration_seconds_bucket[5m]))"
          }
        ]
      },
      {
        "title": "OSINT Reports",
        "type": "stat",
        "targets": [
          {
            "expr": "osint_reports_total"
          }
        ]
      },
      {
        "title": "AI Tokens Used",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ai_tokens_total[5m])"
          }
        ]
      }
    ]
  }
}